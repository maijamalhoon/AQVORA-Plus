# Copy to a local .env file and keep it OUT of Git. Node's start script
# does not automatically load .env: set these in your shell or use an
# approved environment loader. NEVER commit real credentials.
DATABASE_URL=postgres://LOCAL_USERNAME:LOCAL_PASSWORD@localhost:5432/aqvora_plus_demo
NODE_ENV=development
PORT=3000
BOOTSTRAP_COMPANY_CODE=LOCAL01
BOOTSTRAP_COMPANY_NAME=AQVORA Plus Local Demo
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_SECRET
